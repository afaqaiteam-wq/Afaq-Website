# Copy to .env.local for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values.

# Public site URL, used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://afaq-website-ten.vercel.app

# Contact form delivery (server-side only — never exposed to the browser).
# Create a key at https://resend.com → API Keys.
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=
# Optional. A sender on a domain verified in Resend, e.g. "Afaq AI <hello@your-domain>".
# Until a domain is verified, Resend only delivers from onboarding@resend.dev
# to the email address of the Resend account owner.
CONTACT_FROM_EMAIL=
